      <link name="mid360_link">
        <pose>0 0 0.18 3.141592653589793 0 0</pose>
        <inertial>
          <mass>0.265</mass>
          <inertia>
            <ixx>0.00018</ixx>
            <iyy>0.00018</iyy>
            <izz>0.00018</izz>
          </inertia>
        </inertial>
        <visual name="mid360_housing">
          <geometry>
            <box>
              <size>.065 .065 .06</size>
            </box>
          </geometry>
          <material>
            <diffuse>.15 .15 .17 1</diffuse>
          </material>
        </visual>
        <sensor name="mid360_range_image" type="gpu_lidar">
          <topic>/mid360/range_image</topic>
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>1801</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592653589793</min_angle>
                <max_angle>3.141592653589793</max_angle>
              </horizontal>
              <vertical>
                <samples>120</samples>
                <resolution>1</resolution>
                <min_angle>-0.12217304763960307</min_angle>
                <max_angle>0.9075712110370514</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>40</max>
              <resolution>0.002</resolution>
            </range>
          </lidar>
        </sensor>
        <sensor name="mid360_imu" type="imu">
          <topic>/mid360/imu</topic>
          <always_on>true</always_on>
          <update_rate>200</update_rate>
        </sensor>
      </link>
      <joint name="mid360_mount" type="fixed">
